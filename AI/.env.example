# Vorlage für die Konfiguration des AI-Service.
# Kopieren nach .env und Werte eintragen: cp .env.example .env
# Die .env enthält den API-Key und darf nicht eingecheckt werden.

# OpenAI-kompatibler API-Endpunkt des Modell-Anbieters
AI_BASE_URL=
# API-Key des Anbieters
AI_API_KEY=
# Wird als HTTP-Referer-Header an den Anbieter mitgeschickt
AI_SCRIPT_URL=

# Modellnamen, wie sie der Anbieter erwartet
AI_MODEL_NAME=
AI_MODEL_NAME_DIAGNOSIS=
AI_MODEL_NAME_MEDICATION=
VALIDATOR_MODEL_NAME=

# Maximale Anzahl an Validierungsversuchen (Standard: 3)
MAX_VALIDATION_ATTEMPTS=3

# Optional: Port des AI-Service (Standard: 3000).
# Das Backend erwartet den Dienst unter http://localhost:3000 (siehe appsettings.json).
# PORT=3000
