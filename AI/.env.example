# Vorlage für AI/.env (nur nötig, wenn der AI-Service direkt mit "npm start" im Ordner AI
# gestartet wird). Über die Befehle im Projekt-Root (npm run dev, start:test, ...) kommen
# die Werte aus config/<umgebung>.env und config/<umgebung>.local.env.
#
# Kopieren nach AI/.env und ausfüllen. AI/.env ist in .gitignore.

# Geheim
AI_API_KEY=

# Nicht geheim
PORT=3000
AI_SCRIPT_URL=http://localhost:3000
AI_BASE_URL=https://api.eurouter.ai/api/v1
AI_MODEL_NAME=mistral-large-3
AI_MODEL_NAME_DIAGNOSIS=mistral-small-24b
AI_MODEL_NAME_MEDICATION=mistral-small-3.2-24b
VALIDATOR_MODEL_NAME=mistral-nemo-12b
MAX_VALIDATION_ATTEMPTS=3
