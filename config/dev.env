# Umgebung: dev (lokale Entwicklung)
# Nicht-geheime Einstellungen, die im Repo liegen dürfen.
# Geheime Werte (Passwörter, API-Keys) gehören in config/dev.local.env (nicht im Repo).
# Werte, die bereits als echte Umgebungsvariable gesetzt sind, haben Vorrang.

# ─── Allgemein ───
# Kurzname der Umgebung, wählt bei Docker Compose die passenden config-Dateien aus
ENV_NAME=dev
APP_ENV=development

# ─── Backend (.NET) ───
# Lädt zusätzlich appsettings.Development.json (enthält DB-Verbindung zur Docker-DB und einen Dev-JWT-Secret)
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5238

# ─── AI-Service (Node) ───
PORT=3000
AI_SCRIPT_URL=http://localhost:3000
AI_BASE_URL=https://api.eurouter.ai/api/v1
AI_MODEL_NAME=mistral-large-3
AI_MODEL_NAME_DIAGNOSIS=mistral-small-24b
AI_MODEL_NAME_MEDICATION=mistral-small-3.2-24b
VALIDATOR_MODEL_NAME=mistral-nemo-12b
MAX_VALIDATION_ATTEMPTS=3

# ─── Frontend (Expo) ───
# Leer = Standard je Plattform (Android-Emulator: 10.0.2.2, sonst 127.0.0.1).
# Für ein echtes Handy die LAN-IP in config/dev.local.env setzen, z. B.
# EXPO_PUBLIC_API_URL=http://192.168.0.198:5238/api
EXPO_PUBLIC_API_URL=

# ─── Docker (docker-compose.yml) ───
# Image-Version aus der Registry. "local" = lokal gebaut (npm run docker:build)
IMAGE_TAG=local
FRONTEND_PORT=8080

# ─── Monitoring (npm run monitoring:up) ───
# Backend schickt seine Logs zusätzlich an Grafana Alloy → Loki → Grafana.
# Leer lassen/entfernen = nur Konsole. Läuft das Monitoring nicht, passiert nichts weiter.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
