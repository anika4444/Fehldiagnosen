# Umgebung: prod (Produktion, aktuell nur lokal zur Vorbereitung)
# Nicht-geheime Einstellungen, die im Repo liegen dürfen.
# Geheime Werte gehören in config/prod.local.env (Vorlage: config/local.env.example).

# ─── Allgemein ───
# Kurzname der Umgebung, wählt bei Docker Compose die passenden config-Dateien aus
ENV_NAME=prod
APP_ENV=production

# ─── Backend (.NET) ───
# Lädt zusätzlich appsettings.Production.json.
# Pflicht in prod.local.env: ConnectionStrings__mySqlDb, JwtSettings__Secret
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5238

# ─── AI-Service (Node) ───
# Pflicht in prod.local.env: AI_API_KEY
PORT=3000
AI_SCRIPT_URL=http://localhost:3000
AI_BASE_URL=https://api.eurouter.ai/api/v1
AI_MODEL_NAME=mistral-large-3
AI_MODEL_NAME_DIAGNOSIS=mistral-small-24b
AI_MODEL_NAME_MEDICATION=mistral-small-3.2-24b
VALIDATOR_MODEL_NAME=mistral-nemo-12b
MAX_VALIDATION_ATTEMPTS=3

# ─── Frontend (Expo) ───
# TODO: auf die URL des Produktiv-Servers ändern, sobald es einen gibt.
EXPO_PUBLIC_API_URL=http://localhost:5238/api

# ─── Docker (docker-compose.yml) ───
# Image-Version aus der Registry. "local" = lokal gebaut (npm run docker:build)
IMAGE_TAG=local
FRONTEND_PORT=8080
