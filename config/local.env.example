# Vorlage für geheime / persönliche Werte.
# Kopieren nach config/<umgebung>.local.env (z. B. config/test.local.env) und ausfüllen.
# *.local.env-Dateien sind in .gitignore und landen NIE im Repo.
#
# dev:  optional. Ohne diese Datei funktioniert dev mit den Standardwerten aus
#       appsettings.Development.json; nur AI_API_KEY fehlt dann (oder steht in AI/.env).
# test/prod: Pflicht, sonst startet das Backend nicht.

# ─── Backend ───
# Doppelter Unterstrich = Verschachtelung in appsettings.json (ConnectionStrings:mySqlDb)
# Lokal mit der Docker-DB: eigene Datenbank pro Umgebung, root-User darf sie anlegen.
ConnectionStrings__mySqlDb=Server=localhost;Port=3306;Database=adam_api_db_test;User ID=root;Password=root;
# Mindestens 32 Zeichen. Erzeugen z. B. mit:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JwtSettings__Secret=

# ─── AI-Service ───
AI_API_KEY=

# ─── Frontend (optional) ───
# EXPO_PUBLIC_API_URL=http://192.168.0.198:5238/api
