    {
      "id": 28,
      "type": "timeseries",
      "title": "Log-Einträge nach Pegel",
      "description": "Anzahl Log-Einträge je Service und Pegel. Ein Anstieg bei error/warn ist der schnellste Hinweis auf Probleme. Mit gedrückter Maustaste einen Bereich markieren, um auf diesen Zeitraum zu zoomen.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 64
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "sum by (service_name, detected_level) (count_over_time({service_name=~\"$service\"} | request_id=~\"${request_id:raw}.*\" | detected_level=~\"${level:raw}\" [$__auto]))",
          "legendFormat": "{{service_name}} {{detected_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*([Ee]rror|[Ff]atal|[Cc]ritical).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*[Ww]arn.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*[Ii]nfo.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*([Dd]ebug|[Tt]race).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
