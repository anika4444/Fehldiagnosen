# Vorlage für frontend/.env.local (nur nötig, wenn das Frontend direkt mit "npx expo start"
# im Ordner frontend gestartet wird). Über die Befehle im Projekt-Root kommt der Wert aus
# config/<umgebung>.env bzw. config/<umgebung>.local.env.
#
# Leer lassen = Standard je Plattform (Android-Emulator: 10.0.2.2, sonst 127.0.0.1).
# Für ein echtes Handy im selben WLAN die LAN-IP des Laptops eintragen:
EXPO_PUBLIC_API_URL=http://192.168.0.198:5238/api
